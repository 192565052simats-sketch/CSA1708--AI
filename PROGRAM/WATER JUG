from collections import deque

def water_jug(cap1, cap2, target):
    queue = deque([(0, 0)])
    visited = set()

    while queue:
        jug1, jug2 = queue.popleft()

        if (jug1, jug2) in visited:
            continue

        visited.add((jug1, jug2))
        print("Jug 1:", jug1, " Jug 2:", jug2)

        if jug1 == target or jug2 == target:
            print("Target reached!")
            return

        states = [
            (cap1, jug2),                  # Fill Jug 1
            (jug1, cap2),                  # Fill Jug 2
            (0, jug2),                     # Empty Jug 1
            (jug1, 0),                     # Empty Jug 2
            (min(cap1, jug1 + jug2),       # Pour Jug 2 → Jug 1
             max(0, jug2 - (cap1 - jug1))),
            (max(0, jug1 - (cap2 - jug2)), # Pour Jug 1 → Jug 2
             min(cap2, jug1 + jug2))
        ]

        for state in states:
            if state not in visited:
                queue.append(state)

    print("No solution exists.")


# Dynamic input
cap1 = int(input("Enter capacity of Jug 1: "))
cap2 = int(input("Enter capacity of Jug 2: "))
target = int(input("Enter target amount: "))

water_jug(cap1, cap2, target)
